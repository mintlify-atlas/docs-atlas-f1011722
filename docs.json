            ]
          },
          {
            "group": "Markdown & Formatting",
            "pages": [
              "content/markdown-guide",
              "content/math-diagrams",
              "content/front-matter"
            ]
          },
          {
            "group": "Markdown Generators",
            "pages": [
              "generators/overview",
              "generators/publications-generator",
              "generators/talks-generator"
            ]
          }
