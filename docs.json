{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Academic Pages",
  "theme": "willow",
  "colors": {
    "primary": "#3464cc"
  },
  "favicon": "https://media.brand.dev/f272502e-8db7-4b77-a7d2-3e77e6a2a846.png",
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/academicpages/academicpages.github.io"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/academicpages/academicpages.github.io"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "introduction",
              "quickstart"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/site-settings",
              "configuration/author-profile",
              "configuration/navigation",
              "configuration/themes"
            ]
          },
          {
